<%- include('partials/header') %>
<article class="card pub-article">
  <p class="kicker"><a href="/publications/s/<%= s.slug %>"><%= s.icon %> <%= s.name[lang] || s.name.fr %></a></p>
  <% if (p.status !== 'published') { %>
    <p class="notice"><strong><%= t('pub.status_' + p.status) %></strong> · <%= t('pub.confidential') %><% if (isAdmin) { %> · <a href="/admin/articles/<%= p.id %>"><%= t('pub.desk') %></a><% } %></p>
  <% } %>
  <h1><%= p.title %></h1>
  <p class="muted">Dr <%= p.author_name %> · <%= new Date(dateOf(p) + 'Z').toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %><% if (p.status === 'published') { %> · <span class="tag"><%= t('pub.peer_reviewed') %></span><% } %></p>
  <p class="lead pub-summary"><%= p.summary %></p>
  <% if (p.body) { %><div class="pub-body"><%= p.body %></div><% } %>
  <% if (p.link) { %><p><a class="btn btn-ghost" href="<%= p.link %>" target="_blank" rel="noopener nofollow"><%= t('pub.full_text') %> ↗</a></p><% } %>
  <p class="muted small"><%= t('pub.disclaimer') %></p>
</article>

<% if (canReview) { %>
  <section class="card section pub-article" id="review">
    <h2><%= t('pub.your_review') %></h2>
    <p class="muted"><%= t('pub.review_help') %></p>
    <form method="post" action="/publications/a/<%= p.id %>/review" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="pub-decisions">
        <% for (const d of ['accept', 'revise', 'reject']) { %>
          <label class="pub-decision"><input type="radio" name="decision" value="<%= d %>" required <%= mine?.decision === d ? 'checked' : '' %>> <%= t('pub.decision_' + d) %></label>
        <% } %>
      </div>
      <label for="r-comments"><%= t('pub.comments') %></label>
      <textarea id="r-comments" name="comments" rows="6" maxlength="5000"><%= mine?.comments || '' %></textarea>
      <button class="btn btn-red"><%= mine ? t('pub.update_review') : t('pub.send_review') %></button>
    </form>
  </section>
<% } %>
<%- include('partials/footer') %>
