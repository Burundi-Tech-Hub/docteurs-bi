<%- include('partials/header') %>
<section class="card pub-hero">
  <p class="kicker"><%= t('conf.kicker') %></p>
  <h1><%= t('conf.title') %></h1>
  <p class="lead"><%= t('conf.lead') %></p>
  <% if (user && user.role === 'admin') { %><a class="btn btn-navy" href="/admin/congres"><%= t('conf.manage') %></a><% } %>
</section>

<section class="section" id="afrique">
  <h2 class="rubric"><%= t('conf.region') %> <span class="pub-count"><%= events.length %></span></h2>
  <% if (!events.length) { %><p class="card muted"><%= t('conf.region_none') %></p><% } %>
  <div class="article-list">
    <% const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }); %>
    <% for (const e of events) { %>
      <article class="card article conf-event">
        <p class="article-meta"><%= fmt(e.start_date) %><%= e.end_date && e.end_date !== e.start_date ? ' – ' + fmt(e.end_date) : '' %> · <%= [e.city, e.country].filter(Boolean).join(', ') %> · <span class="sp-tag"><%= t('conf.format.' + e.format) %></span></p>
        <h3><% if (e.link) { %><a href="<%= e.link %>" target="_blank" rel="noopener"><%= e.title %> ↗</a><% } else { %><%= e.title %><% } %></h3>
        <% if (e.notes) { %><p><%= e.notes %></p><% } %>
      </article>
    <% } %>
  </div>
</section>

<section class="section">
  <h2 class="rubric"><%= t('conf.international') %></h2>
  <article class="card conf-card">
    <div class="conf-logo" aria-hidden="true">🗓️</div>
    <div>
      <h2>medcal.fr</h2>
      <p><%= t('conf.medcal') %></p>
      <ul class="conf-points">
        <li><%= t('conf.p_filters') %></li>
        <li><%= t('conf.p_online') %></li>
        <li><%= t('conf.p_dpc') %></li>
      </ul>
      <div class="actions">
        <a class="btn btn-red" href="https://medcal.fr/" target="_blank" rel="noopener"><%= t('conf.open') %> ↗</a>
        <a class="btn btn-ghost" href="https://medcal.fr/?vue=liste" target="_blank" rel="noopener"><%= t('conf.list') %> ↗</a>
        <% for (const m of months) { %><a class="btn btn-ghost" href="https://medcal.fr/?debut=<%= m.key %>" target="_blank" rel="noopener"><%= m.label %> ↗</a><% } %>
      </div>
      <p class="muted small"><%= t('conf.note') %></p>
    </div>
  </article>
</section>

<section class="section">
  <div class="card conf-tip">
    <h2 class="rubric small"><%= t('conf.share_title') %></h2>
    <p><%= t('conf.share') %></p>
    <a class="btn btn-navy" href="/contact?topic=event"><%= t('conf.share_btn') %></a>
  </div>
</section>
<%- include('partials/footer') %>
