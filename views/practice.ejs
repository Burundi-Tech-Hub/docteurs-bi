<%- include('partials/header') %>
<section class="card hero-main">
  <p class="kicker">Medscape · UpToDate</p>
  <h1><%= t('practice.title') %></h1>
  <p class="lead"><%= t('practice.lead') %></p>
</section>

<div class="practice section">
  <section>
    <div class="section-head">
      <h2 class="rubric"><%= t('practice.news') %></h2>
      <% if (feed.at) { %><span class="muted small"><%= t('practice.updated') %> <%= new Date(feed.at).toLocaleTimeString(lang === 'en' ? 'en-GB' : 'fr-FR', { hour: '2-digit', minute: '2-digit' }) %></span><% } %>
    </div>
    <% if (!feed.articles.length) { %>
      <p class="card empty"><%= t('practice.empty') %></p>
    <% } %>
    <div class="article-list">
      <% for (const a of feed.articles) { %>
        <article class="card article">
          <p class="article-meta"><%= a.source %><% if (a.date) { %> · <%= new Date(a.date).toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) %><% } %></p>
          <h3><a href="<%= a.link %>" target="_blank" rel="noopener"><%= a.title %></a></h3>
          <% if (a.summary) { %><p><%= a.summary %></p><% } %>
          <a class="article-more" href="<%= a.link %>" target="_blank" rel="noopener"><%= t('practice.read') %> ↗</a>
        </article>
      <% } %>
    </div>
    <p class="muted small"><%= t('practice.medscape_note') %></p>
  </section>

  <aside>
    <div class="promo uptodate">
      <p class="promo-kicker">UpToDate</p>
      <h2><%= t('practice.uptodate_title') %></h2>
      <p><%= t('practice.uptodate_lead') %></p>
      <form class="uptodate-form" action="https://www.uptodate.com/contents/search" method="get" target="_blank" rel="noopener">
        <label class="sr-only" for="utd-q"><%= t('practice.uptodate_title') %></label>
        <input id="utd-q" name="search" type="search" required placeholder="<%= t('practice.uptodate_placeholder') %>">
        <button class="btn btn-red btn-block"><%= t('practice.uptodate_button') %></button>
      </form>
      <p class="small"><%= t('practice.uptodate_updates') %></p>
    </div>
  </aside>
</div>
<p class="muted small center"><%= t('practice.disclaimer') %></p>
<%- include('partials/footer') %>
