<%- include('partials/header') %>
<div class="two-col">
  <section class="card">
    <h1 class="rubric"><%= article ? t('pub.edit_title') : t('pub.new_title') %></h1>
    <p class="muted"><%= article ? t('pub.edit_lead') : t('pub.new_lead') %></p>
    <% if (reviews.length) { %>
      <div class="pub-reviews">
        <% reviews.forEach((r, i) => { %>
          <div class="pub-review <%= r.decision %>"><strong><%= t('pub.reviewer_n', { n: i + 1 }) %> · <%= t('pub.decision_' + r.decision) %></strong><% if (r.comments) { %><p><%= r.comments %></p><% } %></div>
        <% }) %>
      </div>
    <% } %>
    <form method="post" action="<%= article ? `/publications/a/${article.id}/edit` : '/publications/new' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="a-spec"><%= t('pub.specialty') %></label>
      <select id="a-spec" name="specialty" required>
        <option value=""><%= t('pub.choose') %></option>
        <% for (const [key, list] of [['pub.medicine', medicine], ['pub.surgery', surgery]]) { %>
          <optgroup label="<%= t(key) %>">
            <% for (const s of list) { %><option value="<%= s.slug %>" <%= form.specialty === s.slug ? 'selected' : '' %>><%= s.name[lang] || s.name.fr %></option><% } %>
          </optgroup>
        <% } %>
      </select>
      <label for="a-title"><%= t('pub.f_title') %></label>
      <input id="a-title" name="title" required maxlength="200" value="<%= form.title %>">
      <label for="a-summary"><%= t('pub.f_summary') %></label>
      <textarea id="a-summary" name="summary" rows="4" required maxlength="1500"><%= form.summary %></textarea>
      <label for="a-body"><%= t('pub.f_body') %></label>
      <textarea id="a-body" name="body" rows="14" maxlength="30000"><%= form.body %></textarea>
      <label for="a-link"><%= t('pub.f_link') %></label>
      <input id="a-link" name="link" type="url" maxlength="500" placeholder="https://" value="<%= form.link %>">
      <button class="btn btn-red"><%= article ? t('pub.resubmit') : t('pub.submit') %></button>
    </form>
  </section>
  <aside class="promo">
    <p class="promo-kicker"><%= t('pub.peer_review') %></p>
    <h2><%= t('pub.aside_title') %></h2>
    <p><%= t('pub.aside') %></p>
  </aside>
</div>
<%- include('partials/footer') %>
