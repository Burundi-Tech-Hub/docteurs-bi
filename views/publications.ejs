<%- include('partials/header') %>
<section class="card pub-hero">
  <p class="kicker"><%= t('pub.kicker') %></p>
  <h1><%= t('pub.title') %></h1>
  <p class="lead"><%= t('pub.lead') %></p>
  <nav class="pub-jump">
    <a class="btn btn-red" href="/publications/submit"><%= t('pub.new') %></a>
    <% if (toReview) { %><a class="btn btn-navy" href="/publications/review"><%= t('pub.to_review', { n: toReview }) %></a><% } %>
    <a class="btn btn-ghost" href="#medecine"><%= t('pub.medicine') %></a>
    <a class="btn btn-ghost" href="#chirurgie"><%= t('pub.surgery') %></a>
  </nav>
</section>
<%- include('partials/lead-news') %>

<% if (recent.length) { %>
  <section class="section">
    <h2 class="rubric"><%= t('pub.recent') %></h2>
    <div class="article-list">
      <% for (const a of recent) { const sp = bySlug.get(a.specialty); %>
        <article class="card article">
          <p class="article-meta"><%= sp.icon %> <%= sp.name[lang] || sp.name.fr %> · Dr <%= a.author_name %> · <%= new Date(dateOf(a) + 'Z').toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
          <h3><a href="/publications/a/<%= a.id %>"><%= a.title %></a></h3>
          <p><%= a.summary.length > 260 ? a.summary.slice(0, 257) + '…' : a.summary %></p>
        </article>
      <% } %>
    </div>
  </section>
<% } %>

<% for (const [id, key, list] of [['medecine', 'pub.medicine', medicine], ['chirurgie', 'pub.surgery', surgery]]) { %>
  <section class="section pub-part" id="<%= id %>">
    <h2 class="rubric"><%= t(key) %> <span class="pub-count"><%= list.length %></span></h2>
    <div class="pub-grid">
      <% for (const s of list) { %>
        <article class="card pub-card pub-<%= id %>">
          <span class="pub-icon" aria-hidden="true"><%= s.icon %></span>
          <h3><a class="pub-title" href="/publications/s/<%= s.slug %>"><%= s.name[lang] || s.name.fr %></a></h3>
          <div class="pub-links">
            <a href="/publications/s/<%= s.slug %>"><%= t('pub.members_n', { n: counts[s.slug] || 0 }) %></a>
            <a href="<%= s.latest %>" target="_blank" rel="noopener"><%= t('pub.latest') %> ↗</a>
            <a href="<%= s.africa %>" target="_blank" rel="noopener"><%= t('pub.africa') %> ↗</a>
          </div>
        </article>
      <% } %>
    </div>
  </section>
<% } %>
<p class="muted small"><%= t('pub.source') %></p>
<%- include('partials/footer') %>
