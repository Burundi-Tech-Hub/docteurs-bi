<%- include('partials/header') %>
<div class="two-col contact">
  <section class="card">
    <h1 class="rubric"><%= t('contact.title') %></h1>
    <p class="muted"><%= t('contact.lead') %></p>
    <form method="post" action="/contact" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="c-name"><%= t('contact.name') %></label>
      <input id="c-name" name="name" required maxlength="120" autocomplete="name" value="<%= form.name %>">
      <label for="c-reply"><%= t('contact.reply_to') %></label>
      <input id="c-reply" name="reply_to" required maxlength="120" placeholder="<%= t('contact.reply_to_ph') %>" value="<%= form.reply_to %>">
      <label for="c-topic"><%= t('contact.topic') %></label>
      <select id="c-topic" name="topic">
        <% topics.forEach((k) => { %><option value="<%= k %>" <%= form.topic === k ? 'selected' : '' %>><%= t('contact.topic_' + k) %></option><% }) %>
      </select>
      <label for="c-body"><%= t('contact.body') %></label>
      <textarea id="c-body" name="body" rows="6" required maxlength="4000"><%= form.body %></textarea>
      <div class="hp" aria-hidden="true"><label for="c-web">Website</label><input id="c-web" name="website" tabindex="-1" autocomplete="off"></div>
      <button class="btn btn-red"><%= t('contact.send') %></button>
    </form>
  </section>
  <aside class="promo">
    <p class="promo-kicker"><%= appName %></p>
    <h2><%= t('contact.aside_title') %></h2>
    <p><%= t('contact.aside') %></p>
  </aside>
</div>
<%- include('partials/footer') %>
