<%- include('partials/header') %>
<section class="card narrow">
  <h1 class="rubric"><%= t('login.title') %></h1>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="phone"><%= t('reg.phone') %></label>
    <div class="phone-input"><span>+257</span><input id="phone" name="phone" inputmode="tel" autocomplete="tel" required placeholder="<%= t('reg.phone_ph') %>" value="<%= phoneValue.replace(/^\+?257/, '') %>"></div>
    <label for="password"><%= t('reg.password').replace(/\s*\(.*\)/, '') %></label>
    <input id="password" name="password" type="password" required autocomplete="current-password">
    <button class="btn btn-red btn-block"><%= t('login.submit') %></button>
  </form>
  <p class="center"><a href="/forgot"><%= t('login.forgot') %></a></p>
  <p class="center muted"><%= t('login.no_account') %> <a href="/register"><%= t('nav.join') %></a></p>
</section>
<%- include('partials/footer') %>
