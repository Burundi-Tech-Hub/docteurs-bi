<%- include('partials/header') %>
<div class="section-head"><h1 class="rubric"><%= t('pub.admin_title') %></h1><div class="actions"><a class="btn btn-red" href="/admin/articles/new"><%= t('pub.new_title') %></a><a class="btn btn-ghost" href="/admin"><%= t('admin.title') %></a></div></div>
<section class="card">
  <p class="muted"><%= t('pub.admin_lead') %> <%= email ? email : t('pub.no_email_admin') %></p>
  <% if (!list.length) { %><p class="muted"><%= t('pub.none') %></p><% } %>
  <div class="msg-list">
    <% list.forEach((p) => { const sp = bySlug.get(p.specialty); %>
      <article class="msg-item <%= ['review', 'revision'].includes(p.status) ? 'new' : 'done' %>">
        <p class="muted small"><%= p.created_at %> UTC · <%= sp ? (sp.name[lang] || sp.name.fr) : p.specialty %> · Dr <%= p.author_name %> · <span class="tag <%= ['hidden', 'rejected', 'revision'].includes(p.status) ? 'tag-red' : '' %>"><%= t('pub.status_' + p.status) %></span>
          · <%= t('pub.round_n', { n: p.round }) %> · <%= t('pub.progress', { r: p.reviews_n, a: p.assigned_n }) %></p>
        <strong><a href="/admin/articles/<%= p.id %>"><%= p.title %></a></strong>
      </article>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
