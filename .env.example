# Copy to .env and fill in.
NODE_ENV=production
PORT=3000
BASE_URL=https://medecins.bi
SESSION_SECRET=change-me-to-a-long-random-string
DB_FILE=./data/app.db
# Comma-separated E.164 numbers that become admins on sign-up (the first member is admin anyway).
ADMIN_PHONES=+25779000000

# SMS: console (prints codes in the log) | africastalking | twilio
SMS_DRIVER=console
SMS_SENDER_ID=
AT_USERNAME=
AT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Professional email: console (log only) | mailcow
MAIL_DRIVER=console
MAIL_DOMAIN=medecins.bi
MAIL_AUTO_APPROVE=false
MAIL_QUOTA_MB=2048
MAILCOW_URL=https://mail.medecins.bi
MAILCOW_API_KEY=
WEBMAIL_URL=https://mail.medecins.bi/SOGo

# "Improve your practice": RSS feeds (comma-separated) and the photo beside the title
# PRACTICE_FEEDS=https://www.medscape.com/cx/rssfeeds/2700.xml
# PRACTICE_IMAGE=/static/img/practice.jpg
# PRACTICE_IMAGE_CREDIT=Photo: name / source (licence)
